# Copy this file to .env and adjust it for your machine.
# .env is gitignored. Do not put real API keys in source code.

APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL connection string. 127.0.0.1 reaches the Docker port.
# "localhost" can resolve to a different server on IPv6.
DATABASE_URL=postgresql+psycopg://ai_governance:change-me@127.0.0.1:5432/ai_governance

# Leave extraction disabled to run without an LLM provider.
LLM_ENABLED=false
# LLM_API_KEY=
# LLM_MODEL=

# Directory for locally stored regulatory files.
DATA_DIR=data

# CELLAR content-negotiation root for a CELEX work. The default is the
# Publications Office production API; override it only for a local test double.
# CELLAR_BASE_URL=http://publications.europa.eu/resource/celex
